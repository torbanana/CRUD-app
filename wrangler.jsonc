{
  // Cloudflare Workers config. See README for the deploy steps.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "step-race",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",

  // The frontend. Cloudflare serves these files directly from its edge and only
  // invokes the Worker for paths with no matching file (i.e. /api/*).
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // D1 is Cloudflare's SQLite. This id came from `npx wrangler d1 create
  // step-race` -- it is an identifier, not a secret, and is safe to commit.
  // If you fork this, create your own database and replace it.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "step-race",
      "database_id": "bc0f4a27-8058-4d24-aa4e-01911804be44"
    }
  ],

  "vars": {
    // Decides "what day is it" and when the week rolls over. A Worker runs in
    // whichever datacentre is nearest the visitor, so this must be explicit.
    "APP_TZ": "Asia/Singapore",

    "MAX_MEMBERS": "10",

    // Password hashing cost. 25000 is chosen to fit the Workers FREE plan's
    // 10ms CPU limit (~3ms). It is BELOW the OWASP figure of 600000 and that is
    // a real, accepted weakness -- what makes it survivable is that login is now
    // rate limited (worker/throttle.js), so an attacker gets fifteen guesses in
    // fifteen minutes rather than as many as the network allows.
    //
    // On the paid plan (5 min CPU) raise this to 600000 and delete this excuse.
    // The value is stored inside each hash, so changing it stays backward
    // compatible with existing accounts.
    "PBKDF2_ITERATIONS": "25000"
  },

  // INVITE_CODE is deliberately NOT here -- it is the only thing protecting your
  // ten places, and this file is committed to a public repo. Set it as a secret:
  //   npx wrangler secret put INVITE_CODE
  //
  // There is NO production fallback. A deployed Worker without this secret
  // refuses every signup with a 503 rather than accepting a code printed in a
  // public repo. `wrangler dev` on localhost still accepts STEP2026, because
  // there is nothing there to protect.

  "observability": {
    "enabled": true
  }
}
